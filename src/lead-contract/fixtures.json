{
  "_comment": "Shared by Workbench (test/lead_contract.test.mjs) and the website (scripts/check-lead-contract.mjs). Each case runs through parseLead. `ok:true` cases may list `expect` — a partial of the parsed data. `ok:false` cases list the exact set of field keys that must be refused. Edit here, then run scripts/sync-lead-contract.mjs in example-practice-site.",
  "cases": [
    { "name": "all fields filled", "ok": true,
      "input": { "name": "Test Lead – Form QA", "email": "a@example.com", "phone": "(510) 555-0100", "serviceId": "life", "bestTimeDays": "weekdays", "bestTimeWindow": "evening", "message": "Hello", "textConsent": true, "gclid": "abc", "utm_source": "google", "landing_page": "/consultation", "referrer": "https://www.google.com/" },
      "expect": { "name": "Test Lead – Form QA", "serviceId": "life", "bestTimeDays": "weekdays", "bestTimeWindow": "evening", "textConsent": true, "gclid": "abc", "referrer": "https://www.google.com/", "source": "website" } },
    { "name": "only the three required fields", "ok": true,
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100" },
      "expect": { "serviceId": "", "bestTimeDays": "", "bestTimeWindow": "", "message": "", "textConsent": false } },
    { "name": "legacy nested bestTime is accepted", "ok": true,
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100", "bestTime": { "days": "weekends", "window": "morning" } },
      "expect": { "bestTimeDays": "weekends", "bestTimeWindow": "morning" } },
    { "name": "legacy null serviceId and null bestTime", "ok": true,
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100", "serviceId": null, "bestTime": null },
      "expect": { "serviceId": "" } },
    { "name": "stray old calendar fields are ignored, not rejected", "ok": true,
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100", "bestTime": { "date": "2026-10-09", "time": "10:00" } } },
    { "name": "unknown keys are stripped", "ok": true,
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100", "isAdmin": true, "tenantId": "x" } },
    { "name": "textConsent from an HTML checkbox", "ok": true,
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100", "textConsent": "on" },
      "expect": { "textConsent": true } },
    { "name": "whitespace is trimmed", "ok": true,
      "input": { "name": "  Ada  ", "email": "  a@example.com ", "phone": " 510 555 0100 " },
      "expect": { "name": "Ada", "email": "a@example.com", "phone": "510 555 0100" } },
    { "name": "emoji and accents in the name", "ok": true,
      "input": { "name": "José Álvarez-Núñez 🌿", "email": "a@example.com", "phone": "5105550100" },
      "expect": { "name": "José Álvarez-Núñez 🌿" } },
    { "name": "message at the limit", "ok": true,
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100", "message": "@5000" } },
    { "name": "phone: +1 and spaces", "ok": true, "input": { "name": "A", "email": "a@example.com", "phone": "+1 510 555 0100" } },
    { "name": "phone: dots", "ok": true, "input": { "name": "A", "email": "a@example.com", "phone": "510.555.0100" } },
    { "name": "phone: leading 1", "ok": true, "input": { "name": "A", "email": "a@example.com", "phone": "1-510-555-0100" } },
    { "name": "phone: UK international", "ok": true, "input": { "name": "A", "email": "a@example.com", "phone": "+44 20 7946 0958" } },
    { "name": "phone: 00 international prefix", "ok": true, "input": { "name": "A", "email": "a@example.com", "phone": "0044 20 7946 0958" } },

    { "name": "everything blank", "ok": false, "fields": ["name", "email", "phone"],
      "input": { "name": "", "email": "", "phone": "" } },
    { "name": "empty object", "ok": false, "fields": ["name", "email", "phone"], "input": {} },
    { "name": "non-object body", "ok": false, "fields": ["name", "email", "phone"], "input": "hello" },
    { "name": "nulls", "ok": false, "fields": ["name", "email", "phone"],
      "input": { "name": null, "email": null, "phone": null } },
    { "name": "missing name only", "ok": false, "fields": ["name"],
      "input": { "email": "a@example.com", "phone": "5105550100" } },
    { "name": "whitespace-only name", "ok": false, "fields": ["name"],
      "input": { "name": "   ", "email": "a@example.com", "phone": "5105550100" } },
    { "name": "missing email only", "ok": false, "fields": ["email"],
      "input": { "name": "A", "phone": "5105550100" } },
    { "name": "missing phone only", "ok": false, "fields": ["phone"],
      "input": { "name": "A", "email": "a@example.com" } },
    { "name": "email: abc", "ok": false, "fields": ["email"],
      "input": { "name": "A", "email": "abc", "phone": "5105550100" } },
    { "name": "email: a@b", "ok": false, "fields": ["email"],
      "input": { "name": "A", "email": "a@b", "phone": "5105550100" } },
    { "name": "email: spaces inside", "ok": false, "fields": ["email"],
      "input": { "name": "A", "email": "a b@example.com", "phone": "5105550100" } },
    { "name": "phone: 123", "ok": false, "fields": ["phone"],
      "input": { "name": "A", "email": "a@example.com", "phone": "123" } },
    { "name": "phone: letters", "ok": false, "fields": ["phone"],
      "input": { "name": "A", "email": "a@example.com", "phone": "call me maybe" } },
    { "name": "phone: extension is not a number", "ok": false, "fields": ["phone"],
      "input": { "name": "A", "email": "a@example.com", "phone": "510-555-0100 ext 22" } },
    { "name": "phone: 9 digits", "ok": false, "fields": ["phone"],
      "input": { "name": "A", "email": "a@example.com", "phone": "510770616" } },
    { "name": "name too long", "ok": false, "fields": ["name"],
      "input": { "name": "@121", "email": "a@example.com", "phone": "5105550100" } },
    { "name": "message over the limit", "ok": false, "fields": ["message"],
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100", "message": "@5001" } },
    { "name": "bad days", "ok": false, "fields": ["bestTimeDays"],
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100", "bestTimeDays": "tuesdays" } },
    { "name": "bad window", "ok": false, "fields": ["bestTimeWindow"],
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100", "bestTimeWindow": "midnight" } },
    { "name": "bad legacy nested days", "ok": false, "fields": ["bestTimeDays"],
      "input": { "name": "A", "email": "a@example.com", "phone": "5105550100", "bestTime": { "days": "someday" } } },
    { "name": "several wrong at once", "ok": false, "fields": ["email", "phone", "message"],
      "input": { "name": "A", "email": "abc", "phone": "12", "message": "@5001" } }
  ],
  "phones": [
    { "in": "(510) 555-0100", "e164": "+15105550100" },
    { "in": "510-555-0100", "e164": "+15105550100" },
    { "in": "+1 510 555 0100", "e164": "+15105550100" },
    { "in": "1 (510) 555-0100", "e164": "+15105550100" },
    { "in": "+44 20 7946 0958", "e164": "+442079460958" },
    { "in": "0044 20 7946 0958", "e164": "+442079460958" },
    { "in": "123", "e164": null },
    { "in": "abcdefghij", "e164": null },
    { "in": "510-555-0100 ext 22", "e164": null },
    { "in": "", "e164": null }
  ]
}
