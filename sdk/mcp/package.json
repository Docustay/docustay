{
  "name": "@docustay2026/mcp",
  "version": "0.1.0",
  "description": "Docustay MCP server: let an AI assistant send documents for signature and follow them. Runs on your machine with your own API key.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "docustay-mcp": "./src/server.js"
  },
  "main": "./src/tools.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pretest": "npm install --no-save --no-package-lock ../js"
  },
  "dependencies": {
    "@docustay2026/sdk": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "homepage": "https://docustay.app/developers",
  "keywords": [
    "docustay",
    "e-signature",
    "esignature",
    "documents",
    "signing",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docustay/docustay.git",
    "directory": "sdk/mcp"
  },
  "bugs": {
    "url": "https://github.com/docustay/docustay/issues"
  }
