{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "@keystone/*": ["../src/*"], "@design/*": ["../design/*"] },
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", ".storybook"]
}
