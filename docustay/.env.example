# Docustay self-host settings. `./init.sh` copies this to .env and fills the secrets in for you. Nothing here belongs to anyone else: every secret is generated on YOUR machine.

# ── generated by init.sh (do not share) ─────────────────────────────────────────
KEYSTONE_DB_PASSWORD=
KEYSTONE_S3_ACCESS_KEY_ID=
KEYSTONE_S3_SECRET_ACCESS_KEY=
KEYSTONE_TOKEN_PEPPER=
KEYSTONE_LOCAL_AUTH_SECRET=
# the one-time key that lets you create the owner account at /setup
KEYSTONE_SETUP_TOKEN=

# ── email: set ONE of these, or Docustay will say "Email isn't set up" and refuse to invite signers ──
# Option 1 — Resend (https://resend.com): paste your own API key
RESEND_API_KEY=
# Option 2 — your own SMTP server: leave RESEND_API_KEY empty and enter the server in Docustay → Settings → Email after you sign in.
# The product's default From address (used until you verify your own domain):
KEYSTONE_MAIL_SENDER=

# ── optional ─────────────────────────────────────────────────────────────────────
# The address people reach Docustay at, without a path (for links in emails), e.g. https://sign.example.com
KEYSTONE_PUBLIC_URL=
# Port on this machine
DOCUSTAY_PORT=8080

# Behind a reverse proxy you run (Caddy, nginx, a load balancer)? Set this so signers' addresses (audit trail, certificate, rate limits) are the real ones, not the proxy's. Leave empty when people reach Docustay directly.
# DOCUSTAY_CLIENT_IP_HEADER=X-Forwarded-For
# How many proxies sit in front (default 1)
# DOCUSTAY_PROXY_COUNT=1
